# Copie este archivo como .env y complete los valores. El .env no se sube a Git.

# Cadena de conexión SQLAlchemy a SQL Server (los caracteres especiales de la clave van codificados: @ -> %40)
SQL_SERVER_STRING_CONNECTION="mssql+pymssql://DOMINIO\usuario:clave@servidor:1433/base"

# Esquema propio de la aplicación dentro de la base (se crea solo al arrancar)
BACKLOG_DB_SCHEMA=backlog

# Opcionales
# BACKLOG_PORT=8765
# BACKLOG_COOKIE_SECURE=1        # cuando se publique detrás de HTTPS
# BACKLOG_DB_POOL_SIZE=5
